    {"id":"telegram-public-client","status":"implemented-optional","mode":"local-read-only","inputs":["public-channel-handle"],"outputs":["telegram-public-json"],"requirements":["Telethon","TG_API_ID","TG_API_HASH","local session"]},
    {"id":"jar-static","status":"implemented","mode":"local-static","inputs":["jar-file"],"outputs":["jar-sha256","domain","url","email","package-list"]},
    {"id":"shodan-json","status":"implemented","mode":"local-import","inputs":["shodan-api-json"],"outputs":["ip","domain","cert-sha256"],"caveat":"Import only; Shodan API credentials not required by this pipeline"},
    {"id":"hunter-json","status":"implemented","mode":"local-import","inputs":["hunter-domain-search-json"],"outputs":["email","domain","url"],"caveat":"Import only; Hunter API credentials not required by this pipeline"},
